{% extends "base.html" %}
{% block title %}My Lab Bookings{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-calendar-check"></i> My Lab Bookings</h1>
  <a href="{% url 'lab_list' %}" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Back to Labs
  </a>
</div>

{% if bookings %}
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr><th>Lab</th><th>Date</th><th>Time</th><th>People</th><th>Status</th><th>Note</th></tr>
        </thead>
        <tbody>
          {% for b in bookings %}
            <tr>
              <td>
                <strong>{{ b.lab.name }}</strong>
                <br><small class="text-muted">{{ b.purpose|truncatechars:60 }}</small>
              </td>
              <td><small>{{ b.date }}</small></td>
              <td><small>{{ b.start_time }}–{{ b.end_time }}</small></td>
              <td>{{ b.expected_people }}</td>
              <td><span class="badge bg-{{ b.status_color }}">{{ b.get_status_display }}</span></td>
              <td><small>{{ b.reviewer_note|default:"—" }}</small></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% else %}
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> You haven't made any lab bookings yet.
  </div>
{% endif %}
{% endblock %}